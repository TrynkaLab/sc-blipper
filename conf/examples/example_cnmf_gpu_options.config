// Example overrides for running cNMF factorize and consensus NMF refits with the cNMF GPU engine.
// Prepare, combine, and downstream non-NMF processes keep using params.rn_conda.

params {
    cnmf_gpu {
        enabled=true

        // Set this to the conda env created from environment_gpu.yml.
        // If unset, factorize uses the environment_gpu.yml file in this repo.
        conda="/software/conda/users/ob7/sc-blipper-gpu"

        // Optional shared cNMF GPU runtime overrides. Leave unset to use cNMF defaults.
        // device="cuda"
        // dtype="fp32"
        // allow_tf32=true
        // compile=true
        // compile_block=1
        // check_every=10
        // eps=1e-9

        // Optional process-specific overrides.
        factorize {
            device="cuda"
            dtype="fp32"
            allow_tf32=true
            compile=true
            // batch=1  // replicates packed per GPU launch (factorize only); >1 batches same-k replicates in one launch
        }

        consensus {
            device="cuda"
            dtype="fp32"
            allow_tf32=true
            compile=false
        }
    }
}
