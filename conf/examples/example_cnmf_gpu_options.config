// Example overrides for running GPU-aware cNMF prepare and factorize.
// Consensus, combine, and downstream non-NMF processes continue to run on CPU
// and use params.rn_conda.

params {
    cnmf_gpu {
        // Master switch for all GPU-capable cNMF processes.
        enabled=true

        // GPU processes use params.rn_conda by default. Override only when needed.
        // conda="/path/to/sc-blipper"

        // Prepare still runs on the normal CPU cNMF queue and does not request
        // or use a GPU. It passes `--engine gpu` only to select cNMF's GPU-aware
        // configuration path and persist solver, loss, and iteration settings
        // that are later loaded by GPU factorize.
        prepare {
            enabled=true
            solver="cd"
            beta_loss="frobenius"
            max_iter=4000
        }

        // Optional process-specific overrides.
        factorize {
            enabled=true
            device="cuda"
            dtype="fp32"
            allow_tf32=true
            compile=true
            // batch=1  // replicates packed per GPU launch (factorize only); >1 batches same-k replicates in one launch
        }
    }
}
