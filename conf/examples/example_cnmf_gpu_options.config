// Example overrides for running GPU-aware cNMF prepare and factorize while
// temporarily keeping consensus on CPU. Combine and downstream non-NMF
// processes continue to use params.rn_conda.

params {
    cnmf_gpu {
        // Master switch for all GPU-capable cNMF processes.
        enabled=true

        // GPU processes use params.rn_conda by default. Override only when needed.
        // conda="/path/to/sc-blipper"

        // Optional shared cNMF GPU runtime overrides. Leave unset to use cNMF defaults.
        // device="cuda"
        // dtype="fp32"
        // allow_tf32=true
        // compile=true
        // compile_block=1
        // check_every=10
        // eps=1e-9

        // Prepare does not perform GPU computation, so it stays on the normal
        // cNMF queue. Enabling it selects the GPU-capable environment and
        // persists the solver used by factorize and consensus.
        prepare {
            enabled=true
            solver="cd"
            beta_loss="frobenius"
            max_iter=4000
        }

        // Optional process-specific overrides.
        factorize {
            enabled=true
            device="cuda"
            dtype="fp32"
            allow_tf32=true
            compile=true
            // batch=1  // replicates packed per GPU launch (factorize only); >1 batches same-k replicates in one launch
        }

        consensus {
            // Temporarily keep the consensus refit on CPU.
            enabled=false
            device="cuda"
            dtype="fp32"
            allow_tf32=true
            compile=false
        }
    }
}
